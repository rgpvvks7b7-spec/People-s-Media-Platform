SECRET_KEY=dev-only-change-this
DEBUG=True
API_THROTTLE_ENABLED=0
PLATFORM_MODE=live
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
FRONTEND_URL=http://localhost:5173
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 to exercise real Stripe checkout while DEBUG=True (default: instant demo checkout).
FORCE_STRIPE_CHECKOUT=
STRIPE_CURRENCY=usd
REQUIRE_EMAIL_VERIFICATION=False
SECURE_PROXY_SSL_HEADER=False
STRIPE_AUTOMATIC_TAX=False
SENTRY_DSN=
CONTENT_SECURITY_POLICY=

# YouTube Data API v3 key used to verify artist subscriber counts.
# Leave blank to show "Pending verification" instead of any number.
YOUTUBE_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=IndieFund <noreply@indiefund.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# API rate limits (enabled by default when DEBUG=False)
# API_THROTTLE_ENABLED=1
# API_THROTTLE_ANON=120/min
# API_THROTTLE_USER=600/min

# Production database (optional — defaults to SQLite)
# DATABASE_URL=postgres://user:pass@localhost:5432/indiefund

# Protected audio stream tokens (seconds)
MEDIA_STREAM_TOKEN_SECONDS=3600

# S3 media (optional — defaults to local media/)
# USE_S3_MEDIA=True
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# SERVE_LOCAL_MEDIA=False

# Web push (optional)
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_SUBJECT=mailto:noreply@yourdomain.com
