# Use /api with Vite dev server (proxied to Django). Set a full URL only for production builds.
VITE_API_URL=/api
# Optional bootstrap before /api/health/ loads (prelaunch | live)
VITE_PLATFORM_MODE=
# Pre-release legal badge in footer until lawyer sign-off (true | false)
VITE_LEGAL_PRE_RELEASE=true

# Iubenda (optional — omit for local dev to use markdown legal drafts)
# See legal/IUBENDA_SETUP.md
VITE_IUBENDA_SITE_ID=
VITE_IUBENDA_COOKIE_POLICY_ID=
VITE_IUBENDA_PRIVACY_POLICY_ID=
